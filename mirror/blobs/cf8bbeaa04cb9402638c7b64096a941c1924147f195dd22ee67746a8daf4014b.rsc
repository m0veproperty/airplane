3a:["$","p","p-19",{"children":"Roos WÃ¼stefeld (30) studeerde Toerisme, deed een stewardessenopleiding, is na haar stage blijven hangen bij Eliza was Here, was stewardess op Rotterdam Airport, werkte bij Munckhof Business Travel en Schiphol Travel."}]
3b:["$","blockquote","blockquote-20",{"children":["\n",["$","h3","h3-0",{"children":"Ik had het erg naar mâ€™n zin bij Schiphol Travel, maar zag een vacature voor het bedrijf waar mâ€™n vader werkte die me op het lijf geschreven is."}],"\n",["$","p","p-0",{"children":["$","strong","strong-0",{"children":"Roos WÃ¼stefeld"}]}],"\n"]}]
3c:["$","p","p-20",{"children":"Sophie van Monsjou (26) wilde na haar studie aan de Hotelschool de evenementenkant op, maar zou tijdelijk helpen in het bedrijf van haar vader. Dat is inmiddels 2,5 jaar geleden."}]
3d:["$","blockquote","blockquote-21",{"children":["\n",["$","h3","h3-0",{"children":"Ik ben nooit meer weggegaan."}],"\n",["$","p","p-0",{"children":["$","strong","strong-0",{"children":"Sophie van Monsjou"}]}],"\n"]}]
3e:["$","p","p-21",{"children":"David Roosjen (30) studeerde Toerisme en heeft diverse stages achter de rug. Zo werkte hij in Afrika een half jaar bij een overland touroperator."}]
3f:["$","blockquote","blockquote-22",{"children":["\n",["$","h3","h3-0",{"children":"Toen ik hier begon, heb ik gezegd dat ze me er niet op moesten vastpinnen dat ik blijf."}],"\n",["$","p","p-0",{"children":["$","strong","strong-0",{"children":"David Roosjen"}]}],"\n"]}]
