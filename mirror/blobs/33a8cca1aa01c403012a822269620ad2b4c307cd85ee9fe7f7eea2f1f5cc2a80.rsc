8:["$","div",null,{"className":"lg:col-span-7 prose prose-1","children":["$","div",null,{"children":[["$","p","p-0",{"children":"Ad hoc charter flights with Transavia capacity"}],"\n",["$","p","p-1",{"children":"Through our partnership with Transavia, we arrange ad hoc charter flights based on available residual capacity. Aerodynamics handles all commercial operations and sales on behalf of Transavia, in full accordance with Transavia's standards."}],"\n",["$","p","p-2",{"children":"Transavia ad hoc charter flights are flexible flights operated using available aircraft capacity that is not allocated to scheduled services or fixed charters. These flights are deployed for businesses and individuals requiring tailor-made air transport to a destination of their choice."}],"\n",["$","p","p-3",{"children":"Since 2019, Transavia has partnered with Aerodynamics for this purpose. On behalf of Transavia, we handle the sales and commercial operations of these ad hoc charter flights. This means we act as the operational and commercial extension of the airline, with quality, reliability and execution in accordance with Transavia standards at the forefront of everything we do."}],"\n",["$","p","p-4",{"children":"Ad hoc charter flights can be deployed for a wide variety of purposes, including business travel, events, group transport and private requests."}]]}]}]
