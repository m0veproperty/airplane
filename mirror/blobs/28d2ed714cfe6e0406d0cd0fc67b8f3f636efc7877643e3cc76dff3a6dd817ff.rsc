64:["$","blockquote","blockquote-2",{"children":["\n",["$","h3","h3-0",{"children":"Wij hebben jarenlange ervaring met het begeleiden van aankoop en het professioneel uitvoeren van de vliegoperatie. Van het initiÃ«le aankoopproces tot en met de commercialisatie van het vliegtuig."}],"\n",["$","p","p-0",{"children":["$","strong","strong-0",{"children":"Ronald WÃ¼stefeld"}]}],"\n"]}]
