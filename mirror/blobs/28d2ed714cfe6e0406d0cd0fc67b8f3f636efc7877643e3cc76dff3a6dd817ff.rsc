55:["$","blockquote","blockquote-0",{"children":["\n",["$","h3","h3-0",{"children":"Alle leden van het team zijn ook volwaardig broker,â€ zegt Huyb van Monsjou."}],"\n",["$","p","p-0",{"children":["$","strong","strong-0",{"children":"zegt Huyb van Monsjou."}]}],"\n"]}]
