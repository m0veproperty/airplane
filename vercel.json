{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/replay.mjs": {
      "includeFiles": "mirror/manifest.json",
      "maxDuration": 10
    }
  },
  "routes": [
    {
      "src": "/__mirror/(.*)",
      "dest": "/__mirror_webgl1/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/api/replay?path=$1"
    }
  ],
  "headers": [
    {
      "source": "/__mirror/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
